# hypercell — provider keys and config. Copy to `.env` (which is gitignored) and fill in.
# The cognition seam reads a key by the ProviderConfig's `key_ref` (default: <PROVIDER>_API_KEY).
# Only fill in the providers you actually use; a cell picks its provider by config, not code.

# --- cheap tier ---
DEEPSEEK_API_KEY=
# --- fast tier (~3000 tok/s) ---
CEREBRAS_API_KEY=
# --- others (OpenAI-compatible endpoints) ---
GLM_API_KEY=            # Zhipu / z.ai
KIMI_API_KEY=           # Moonshot
QWEN_API_KEY=           # Alibaba DashScope
GROK_API_KEY=           # xAI
OPENAI_API_KEY=
# --- thin-adapter tiers ---
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# --- hypercell home: where nuclei (ledgers + indexes) live on this host ---
HYPERCELL_HOME=C:\hypercell\.hypercellstate

# --- conductor surface (P0) ---
HYPERCELL_API_HOST=127.0.0.1
HYPERCELL_API_PORT=8787
